# ==============================================================================
# MAGICENCY® APACHE / LITESPEED PRODUCTION CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 01. CRITICAL SECURITY: BLOCK ACCESS TO .ENV AND ALL DOTFILES
# ------------------------------------------------------------------------------
# Deny access to all hidden files and directories (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicit block for any variation of .env files (.env, .env.local, .env.production, etc.)
<FilesMatch "(^|/)\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to backup, log, and source files
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 02. PRODUCTION SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Enforce HTTPS strictly for 1 year including all subdomains with preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent clickjacking / frame embedding
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Modern referrer protection
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unneeded browser hardware and API permissions
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()"

    # Compatible Content-Security-Policy (allows Google Fonts, Vimeo showreel player, WebGL canvas, GA4)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://www.google-analytics.com https://*.google-analytics.com; media-src 'self' https://player.vimeo.com https://*.vimeocdn.com; frame-src 'self' https://player.vimeo.com; connect-src 'self' https://player.vimeo.com https://*.vimeo.com https://*.vimeocdn.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests;"
</IfModule>

# ------------------------------------------------------------------------------
# 03. ENFORCE HTTP TO HTTPS 301 REDIRECTION
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent access to .env via rewrite returning 404
    RewriteRule ^\.env - [R=404,L,NC]
    RewriteRule ^\.git - [R=404,L,NC]

    # 301 Permanent Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.magicency\.ir$ [NC]
    RewriteRule ^(.*)$ https://magicency.ir/$1 [L,R=301]

    # Redirect non-HTTPS traffic to HTTPS with 301 permanent redirect
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Clean .html file handling (serves /route.html directly for /route without trailing slash redirect)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Pre-rendered directory/HTML fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Disable directory browsing
Options -Indexes
